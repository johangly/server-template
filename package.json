{
	"name": "api-base-template",
	"version": "1.0.0",
	"type": "module",
	"description": "Base template for API projects with authentication, users and roles",
	"main": "index.js",
	"scripts": {
		"start": "node index.js",
		"dev": "nodemon index.js",
		"test": "NODE_ENV=test mocha --experimental-specifier-resolution=node 'tests/**/*.test.js'",
		"test:watch": "NODE_ENV=test mocha --experimental-specifier-resolution=node 'tests/**/*.test.js' --watch",
		"test:auth": "NODE_ENV=test mocha --experimental-specifier-resolution=node tests/integration/auth.test.js",
		"test:users": "NODE_ENV=test mocha --experimental-specifier-resolution=node tests/integration/users.test.js",
		"test:roles": "NODE_ENV=test mocha --experimental-specifier-resolution=node tests/integration/roles.test.js",
		"test:ci": "npm run setup:test && npm run test",
		"db:create": "npx sequelize-cli db:create",
		"db:drop": "npx sequelize-cli db:drop",
		"db:migrate": "npx sequelize-cli db:migrate",
		"db:migrate:undo": "npx sequelize-cli db:migrate:undo",
		"db:reset": "npm run db:drop && npm run db:create && npm run db:migrate && npm run db:seed:all",
		"db:seed:all": "node scripts/seed-all.js",
		"seed:roles": "npx sequelize-cli db:seed --seed 20251101155956-seed-roles",
		"seed:users": "npx sequelize-cli db:seed --seed 20251101173023-seed-users",
		"db:create:test": "npx -y dotenv-cli -e .env.test npx sequelize-cli db:create",
		"db:drop:test": "npx -y dotenv-cli -e .env.test npx sequelize-cli db:drop",
		"db:migrate:test": "npx -y dotenv-cli -e .env.test npx sequelize-cli db:migrate",
		"db:seed:all:test": "npx -y dotenv-cli -e .env.test node scripts/seed-all.js",
		"db:reset:test": "npm run db:drop:test && npm run db:create:test && npm run db:migrate:test && npm run db:seed:all:test",
		"setup": "npm install && npm run db:create && npm run db:migrate && npm run db:seed:all",
		"setup:test": "npm install && npm run db:create:test && npm run db:migrate:test && npm run db:seed:all:test",
		"setup:fresh": "npm install && npm run db:reset",
		"docs:serve": "echo 'Documentación disponible en: http://localhost:3001/api-docs' && npm run dev"
	},
	"dependencies": {
		"bcrypt": "^6.0.0",
		"cors": "^2.8.5",
		"dotenv": "^16.3.1",
		"express": "^4.21.2",
		"express-rate-limit": "^8.2.1",
		"express-validator": "^7.0.1",
		"helmet": "^7.1.0",
		"jsonwebtoken": "^9.0.3",
		"nodemailer": "^8.0.7",
		"pg": "^8.11.3",
		"pg-hstore": "^2.3.4",
		"sequelize": "^6.35.2",
		"socket.io": "^4.8.1",
		"swagger-jsdoc": "^6.2.8",
		"swagger-ui-express": "^5.0.1",
		"winston": "^3.11.0",
		"zod": "^4.0.15"
	},
	"devDependencies": {
		"chai": "^6.2.2",
		"chai-http": "^5.1.2",
		"mocha": "^11.7.5",
		"nodemon": "^3.0.2",
		"sequelize-cli": "^6.6.3",
		"supertest": "^6.3.3"
	}
}
