{
	"name": "api-base-template",
	"version": "1.0.0",
	"type": "module",
	"description": "Base template for API projects with authentication, users and roles",
	"main": "index.js",
	"scripts": {
		"start": "node index.js",
		"dev": "nodemon index.js",
		"test": "NODE_OPTIONS=--experimental-vm-modules jest",
		"test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
		"test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
		"test:auth": "NODE_OPTIONS=--experimental-vm-modules jest tests/integration/auth.test.js",
		"test:users": "NODE_OPTIONS=--experimental-vm-modules jest tests/integration/users.test.js",
		"test:roles": "NODE_OPTIONS=--experimental-vm-modules jest tests/integration/roles.test.js",
		"migrate": "npx sequelize-cli db:migrate",
		"seed:roles": "npx sequelize-cli db:seed --seed 20251101155956-seed-roles",
		"seed:users": "npx sequelize-cli db:seed --seed 20251101173023-seed-users",
		"migration:revert": "npx sequelize-cli db:migrate:undo"
	},
	"dependencies": {
		"bcrypt": "^6.0.0",
		"cors": "^2.8.5",
		"dotenv": "^16.3.1",
		"express": "^4.21.2",
		"express-rate-limit": "^8.2.1",
		"express-validator": "^7.0.1",
		"helmet": "^7.1.0",
		"jsonwebtoken": "^9.0.3",
		"pg": "^8.11.3",
		"pg-hstore": "^2.3.4",
		"nodemailer": "^8.0.7",
		"sequelize": "^6.35.2",
		"socket.io": "^4.8.1",
		"winston": "^3.11.0",
		"zod": "^4.0.15"
	},
	"devDependencies": {
		"jest": "^29.7.0",
		"nodemon": "^3.0.2",
		"sequelize-cli": "^6.6.3",
		"supertest": "^6.3.3"
	}
}
